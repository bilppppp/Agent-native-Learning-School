# Local start uses DEPLOY_TARGET=dev (the default).
# ./script/serve sets DEPLOY_TARGET=node.
# Vercel: ./script/deploy-vercel sets DEPLOY_TARGET=vercel and connects a private Blob store (BLOB_STORE_ID).

# HOST=0.0.0.0
# PORT=4321
# PUBLIC_ORIGIN=https://school.example.com
# TRUST_PROXY=false
# PROGRESS_DIR=
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
