---
export const prerender = true;

import Base from "../layouts/Base.astro";

import { t } from "../lib/ui";
---

<Base title={t("glossary")} description={t("glossaryDescription")}>
  <div class="mb-6">
    <a href="/" class="text-sm text-gray-500 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">{t("home")}</a>
  </div>

  <header class="mb-8">
    <h1 class="text-3xl font-bold">{t("glossary")}</h1>
    <p class="text-gray-600 dark:text-gray-400 mt-2">{t("glossaryDescription")}</p>
  </header>

  <article class="prose dark:prose-invert max-w-none">
    <!-- Add glossary terms here as you create lesson content. Example: -->
    <!-- <h2 id="term">Term</h2> -->
    <!-- <p>Definition of the term.</p> -->
    <p class="text-gray-500 dark:text-stone-500 italic">{t("glossaryEmpty")}</p>
  </article>
</Base>
